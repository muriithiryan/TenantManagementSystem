<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tenant Management Dashboard"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tenantCountText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total tenants: 0"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/totalRentText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total rent\nKSh 0"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/addTenantButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ADD TENANT"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/viewTenantsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VIEW TENANTS" />


</LinearLayout>
